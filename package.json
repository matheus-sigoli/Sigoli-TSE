{
  "name": "sigoli-tse",
  "version": "0.1.0",
  "private": true,
  "description": "Sigoli.TSE — resultados das Eleições 2026 por município, com dados oficiais do TSE.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "typecheck": "tsc --noEmit",
    "malha": "node --max-old-space-size=6144 scripts/malha.mjs",
    "coletar": "node scripts/coletar-tse.mjs",
    "processar": "node scripts/processar-tse.mjs",
    "dados": "npm run coletar && npm run processar",
    "test": "node --test scripts/test/*.test.mjs",
    "bairros": "node --max-old-space-size=6144 scripts/bairros.mjs",
    "zonas": "node --max-old-space-size=6144 scripts/zonas-locais.mjs --baixar"
  },
  "dependencies": {
    "lottie-web": "5.13.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/geojson": "7946.0.16",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "d3-delaunay": "6.0.4",
    "polygon-clipping": "0.15.7",
    "topojson-client": "3.1.0",
    "topojson-server": "3.0.1",
    "yauzl": "3.2.0"
  }
}
