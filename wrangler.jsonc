// Site na Cloudflare (Workers, só arquivos estáticos): o build da Cloudflare roda "npm run build:cloudflare", que gera
// out/ sem as pastas data/ e geo/ (resultados e malhas ficam no Worker sigoli-tse-dados, wrangler.dados.jsonc, porque o limite é de
// 20 mil arquivos por Worker). Sem código de Worker: as requisições de arquivos estáticos não contam no plano.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sigoli-tse",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
